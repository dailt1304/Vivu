{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "SecureKeyFor",
    "Issuer": "Vivu",
    "Audience": "VivuUsers",
    "ExpiryInMinutes": 60
  },
  "EmailSettings": {
    "Email": "Email",
    "Password": "App-password",
    "Host": "Email-host",
    "Port": 587
  },
  "Cloud": {
    "Provider": "ProviderName",
    "APIKey": "Provider-API-Key",
    "APISecret": "Provider-API-Secret"
  },
  "URLs": {
    "FrontendURL": "https://Vivu.com",
    "BackendURL": "https://client.Vivu.com"
  },
  "Redis": {
    "ConnectionString": "Redis-connection-string"
  },
  "EnableSwagger": false,
  "CorsSettings": {
    "AllowedOrigins": [
      "https://Vivu.com",
      "https://client.Vivu.com"
    ]
  }
}